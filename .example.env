NODE_ENV=development
DATABASE_URL=mongodb://localhost:27017/your-database-name
IP_ADDRESS=0.0.0.0
PORT=5055

# Only used by the "mongo" service in docker-compose.yml (native/local Mongo
# doesn't need auth). Harmless if unused when running natively.
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=your-mongo-root-password

BCRYPT_SALT_ROUNDS=12

EMAIL_FROM=your-verified-sender@example.com
RESEND_API_KEY=your-resend-api-key

JWT_SECRET=your-jwt-secret
JWT_EXPIRE_IN=10d
JWT_REFRESH_SECRET=your-jwt-refresh-secret
JWT_REFRESH_EXPIRES_IN=180d
TEMP_JWT_SECRET=your-temp-jwt-secret
TEMP_JWT_EXPIRES_IN=5m

CLOUDINARY_NAME=your-cloudinary-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_SECRET=your-cloudinary-secret

GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=https://your-domain.com/api/v1/auth/google/callback

SUPER_ADMIN_EMAIL=super-admin@example.com
SUPER_ADMIN_PASSWORD=your-super-admin-password

STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret

FIREBASE_SERVICE_ACCOUNT_BASE64=your-base64-encoded-firebase-service-account-json

FRONTEND_URL=http://localhost:3000

# Add any additional environment variables here
