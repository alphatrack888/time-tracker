{
  "name": "template",
  "version": "1.0.0",
  "description": "> A modern and scalable software application.",
  "moduleGenerator": {
    "modulesDir": "src/app/modules",
    "routesFile": "src/routes/index.ts"
  },
  "license": "ISC",
  "author": "Asaduzzaman",
  "type": "commonjs",
  "main": "src/server.ts",
  "scripts": {
    "start": "ts-node-dev --respawn --transpile-only src/server.ts",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start:prod": "node dist/server.js",
    "docker:dev": "docker compose -f docker-compose.yml -f docker-compose.dev.yml up --build",
    "docker:prod": "docker compose -f docker-compose.yml -f docker-compose.prod.yml up --build -d",
    "docker:logs": "docker compose -f docker-compose.yml -f docker-compose.dev.yml logs app -f",
    "docker:ps": "docker compose -f docker-compose.yml -f docker-compose.dev.yml ps",
    "docker:down": "docker compose -f docker-compose.yml -f docker-compose.dev.yml down",
    "docker:build:prod": "docker build --platform linux/arm64 --target prod -t shfayetwt/time-tracker-backend:latest .",
    "docker:push": "docker push shfayetwt/time-tracker-backend:latest",
    "docker:release": "npm run docker:build:prod && npm run docker:push",
    "lint:check": "eslint .",
    "lint:fix": "eslint . --fix",
    "prettier:check": "prettier --ignore-path .gitignore --write \"**/*.+(js|ts|json)\"",
    "prettier:fix": "prettier --write .",
    "lint-prettier": "yarn lint:check && yarn prettier:check",
    "test": "jest",
    "test:watch": "jest --watch",
    "prepare": "husky || true"
  },
  "dependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.12",
    "bcrypt": "^5.1.1",
    "cloudinary": "^2.5.1",
    "colors": "^1.4.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "firebase-admin": "^13.4.0",
    "http-status-codes": "^2.3.0",
    "jsonwebtoken": "^9.0.2",
    "leo-generator": "^1.0.0",
    "moment": "^2.30.1",
    "mongoose": "^8.9.4",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "node-cache": "^5.1.2",
    "node-cron": "^4.2.1",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-local": "^1.0.0",
    "pdfkit": "^0.17.2",
    "prettier": "^3.4.2",
    "resend": "^6.28.1",
    "socket.io": "^4.8.1",
    "stripe": "^18.4.0",
    "winston": "^3.17.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^9.39.5",
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.10",
    "@types/passport": "^1.0.17",
    "@types/passport-google-oauth20": "^2.0.16",
    "@types/passport-local": "^1.0.38",
    "@types/pdf-parse": "^1.1.5",
    "@types/pdfkit": "^0.17.3",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.19.1",
    "@typescript-eslint/parser": "^8.19.1",
    "eslint": "^9.18.0",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "mongodb-memory-server": "^11.3.0",
    "pdf-parse": "^1.1.1",
    "supertest": "^7.3.0",
    "ts-jest": "^29.4.12",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.3"
  },
  "lint-staged": {
    "src/**/*.ts": "npm run lint-and-format"
  }
}
